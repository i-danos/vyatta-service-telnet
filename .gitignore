# Build output. The upstream tree carries no .gitignore, and DANOS builds in
# place, so both the debhelper and the compiler artefacts land beside the
# source.

# compiler output
/mini-inetd
*.o

# debhelper
/debian/files
/debian/tmp/
/debian/.debhelper/
/debian/*.substvars
/debian/*.debhelper.log
/debian/*.debhelper
/debian/vyatta-service-telnet/
/debian/vyatta-service-telnet-v1-yang/
/debian/vyatta-service-telnet-routing-instance-v1-yang/
/debian/vyatta-telnet-routing-instance/
/debian/vyatta-service-telnet-dbgsym/

# quilt
/.pc/
